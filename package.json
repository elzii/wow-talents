{
  "name": "wow-talents",
  "version": "1.0.0",
  "description": "WoW Talent Calculator for Classic, TBC, and Forever with Custom Class Builder, powered by ElectroBun",
  "scripts": {
    "css": "bunx @tailwindcss/cli -i src/mainview/styles.css -o src/mainview/index.css",
    "dev": "bun run css && electrobun dev",
    "build": "bun run css && electrobun build",
    "start": "bun run build && bun run dev",
    "static": "bun run scripts/build_static.ts",
    "serve": "bunx serve build/static"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "electrobun": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}